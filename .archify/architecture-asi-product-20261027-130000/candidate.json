  "cards": [
    {
      "dot": "cyan",
      "title": "Architectural Center",
      "items": [
        "ASI Intelligence Orchestrator is the central brain",
        "Intent / requirements / research / planning / architecture / decision / context / build-contract / agents / model router orbit it",
        "Verification alone may declare completion"
      ]
    },
    {
      "dot": "emerald",
      "title": "Trust Boundaries",
      "items": [
        "Client: Electron renderer / CLI / future web",
        "Trusted Local Backend: API, intelligence, policy, secret broker, verification, data",
        "Restricted Execution: sandbox, generated code, shell, workers",
        "Model Providers: OpenAI / Anthropic / Google / OpenRouter / local",
        "External Dev Systems: GitHub, Codex, Claude Code, cloud"
      ]
    },
    {
      "dot": "violet",
      "title": "Where Things Live",
      "items": [
        "Intelligence: Intelligence Plane (orchestrator)",
        "Project understanding: Project Intelligence",
        "Execution: Execution Plane + Sandbox",
        "Models: Model Provider Layer (external)",
        "Tools: Tool Runtime",
        "Sandboxing: Sandbox Manager (Docker default)",
        "Durable state: PostgreSQL (canonical)",
        "Memory: Memory Platform (not just vector DB)",
        "Verification: Verification Engine"
      ]
    },
    {
      "dot": "amber",
      "title": "Coding Workers Are Replaceable",
      "items": [
        "Codex / Claude Code / Cline / Cursor / OpenCode / Antigravity are execution workers",
        "They do NOT own architecture, plans, memory, permissions, verification, or completion",
        "Flow: Orchestrator -> Task Runtime -> Worker Adapter -> External Worker -> Verification"
      ]
    },
    {
      "dot": "rose",
      "title": "Cross-Cutting Rules",
      "items": [
        "Policy enforced by deterministic trusted code, not LLM instructions",
        "Agent -> shell / filesystem only via Tool Runtime -> Policy -> Sandbox",
        "No agent -> shell or filesystem directly",
        "Redis is ephemeral coordination, never canonical state",
        "Temporal is future-only; BullMQ + PostgreSQL for V1"
      ]
    }
  ]
}