{
  "name": "sirona-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node migrations/runMigrations.js",
    "seed": "node scripts/seedSettings.js",
    "test:db": "node scripts/verifyDb.js",
    "lint:foundation": "node ../frontend/sirona-next/node_modules/oxlint/bin/oxlint --deny-warnings app.js server.js foundation controllers/healthController.js routes/health.routes.js middleware/errorHandler.js scripts/checkSyntax.js tests middleware/httpBoundary.js middleware/problem.js middleware/auditContext.js services/socket.js middleware/rateLimiter.js config/db.js config/redis.js",
    "check": "node scripts/checkSyntax.js",
    "test": "node --test --test-concurrency=1 --test-timeout=15000 tests/*.test.js",
    "test:unit": "node --test --test-timeout=15000 tests/config.test.js tests/runner.test.js tests/runtimeConfig.test.js",
    "test:behavioral": "node --test --test-concurrency=1 --test-timeout=15000 tests/foundation.test.js tests/lifecycle.test.js tests/boundary.test.js tests/production.test.js tests/cli.test.js",
    "verify": "node scripts/verify.js",
    "check:runtime": "node scripts/verifyRuntime.js",
    "lint": "node ../frontend/sirona-next/node_modules/oxlint/bin/oxlint --deny-warnings .",
    "check:strict": "node scripts/checkStatic.js --strict",
    "check:static": "node scripts/checkStatic.js",
    "check:modules": "node scripts/checkModules.js",
    "build:workspace": "tsc -p tsconfig.workspace.json",
    "check:workspace": "tsc -p tsconfig.workspace.json --noEmit",
    "test:workspace": "npm run build:workspace && node --test --test-concurrency=1 --test-timeout=30000 dist-workspace/tests/*.test.js",
    "prestart": "npm run build:workspace",
    "predev": "npm run build:workspace",
    "pretest": "npm run build:workspace"
  },
  "keywords": [
    "sirona",
    "agent",
    "developer",
    "backend",
    "postgresql",
    "express"
  ],
  "author": "Sirona Team",
  "license": "ISC",
  "description": "Production PostgreSQL + Express backend for Sirona Autonomous Developer Agent",
  "dependencies": {
    "@ai-sdk/google": "4.0.107",
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^2.31.0",
    "@langchain/langgraph": "^0.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "ai": "7.0.156",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.4",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "openai": "^4.85.0",
    "pg": "^8.13.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "^9.0.0",
    "socket.io": "^4.8.3",
    "ws": "8.22.0",
    "zod-v4": "npm:zod@4.6.7"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
