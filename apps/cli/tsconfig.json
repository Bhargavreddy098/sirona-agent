{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "types": ["node"], "noEmitOnError": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src", "declaration": true
  },
  "include": ["src/**/*.ts"]
}
