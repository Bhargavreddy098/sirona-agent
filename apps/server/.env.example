# =====================================================================
# Sirona Autonomous Developer Agent — Backend Configuration
# =====================================================================

# Server
PORT=8000
NODE_ENV=development
ASI_HOST=127.0.0.1
ASI_STARTUP_TIMEOUT_MS=5000
ASI_SHUTDOWN_TIMEOUT_MS=10000
ASI_READINESS_TIMEOUT_MS=2000
LOG_LEVEL=info
RATE_LIMIT_POINTS=300
RATE_LIMIT_DURATION=60
# Production ignores implicit .env loading; ASI_ENV_FILE explicitly opts into a trusted file.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/replace-database
# Required: provisioned credentials supplied explicitly. No default postgres password is used.
# Do not connect/migrate the held existing database as part of recovery testing.
# Or individual credentials:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=sirona
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=true
# PGPOOL_MAX=20
# PGCONN_TIMEOUT=5000
# PGIDLE_TIMEOUT=30000

# LEGACY / DEFERRED settings below are not Stage 01 bootstrap/session qualification.
# JWT Authentication
JWT_SECRET=super_secret_sirona_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Providers (OpenAI SDK & Google GenAI ADK)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# Redis & Caching
# Optional cache; disabled if neither URL nor host is configured. Not required for readiness.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# AWS S3 Uploads (Artifacts & Workspace Snapshots)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=sirona-artifacts
# AWS_S3_ENDPOINT=http://localhost:4566
# AWS_S3_FORCE_PATH_STYLE=false

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Sirona Agent Studio <no-reply@sirona.local>

# Telemetry & Diagnostics
DEBUG_SQL=false
DEBUG_REDIS=false

# Default-off P3 trusted-local Docker profile; separate working-database rollout approval required.
SIRONA_TRUSTED_LOCAL_DOCKER_ENABLED=false
