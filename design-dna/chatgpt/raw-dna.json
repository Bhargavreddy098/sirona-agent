{
  "app": "ChatGPT Desktop (Windows)",
  "package": "OpenAI.Codex",
  "typography": {
    "fontFamilies": {
      "primary": "OpenAI Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
    },
    "weights": {
      "light": 300,
      "normal": 400,
      "book": 430,
      "medium": 500,
      "mediumAlt": 510,
      "semibold": 590,
      "bold": 600,
      "heavy": 700
    },
    "scale": {
      "text-2xs": {
        "size": "11px",
        "lineHeight": "14px",
        "letterSpacing": "normal"
      },
      "text-xs": {
        "size": "12px",
        "lineHeight": "16px",
        "letterSpacing": "normal"
      },
      "text-sm": {
        "size": "14px",
        "lineHeight": "20px",
        "letterSpacing": "normal"
      },
      "text-base": {
        "size": "16px",
        "lineHeight": "24px",
        "letterSpacing": "normal"
      },
      "text-lg": {
        "size": "18px",
        "lineHeight": "28px",
        "letterSpacing": "-0.01em"
      },
      "text-xl": {
        "size": "20px",
        "lineHeight": "28px",
        "letterSpacing": "-0.015em"
      },
      "text-2xl": {
        "size": "24px",
        "lineHeight": "32px",
        "letterSpacing": "-0.02em"
      },
      "text-3xl": {
        "size": "30px",
        "lineHeight": "36px",
        "letterSpacing": "-0.025em"
      },
      "text-4xl": {
        "size": "36px",
        "lineHeight": "40px",
        "letterSpacing": "-0.03em"
      }
    },
    "roles": {
      "sidebarHeader": {
        "fontSize": "12px",
        "fontWeight": "510",
        "lineHeight": "16px",
        "color": "var(--text-tertiary)",
        "textTransform": "none"
      },
      "sidebarItem": {
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "20px",
        "color": "var(--text-primary)"
      },
      "sidebarItemActive": {
        "fontSize": "14px",
        "fontWeight": "510",
        "lineHeight": "20px",
        "color": "var(--text-primary)"
      },
      "assistantMessage": {
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "28px",
        "color": "var(--text-primary)"
      },
      "userMessage": {
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "var(--text-primary)"
      },
      "composerInput": {
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "var(--text-primary)"
      },
      "composerPlaceholder": {
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "var(--text-tertiary)"
      },
      "buttonPrimary": {
        "fontSize": "14px",
        "fontWeight": "510",
        "lineHeight": "20px",
        "color": "#ffffff"
      },
      "buttonSecondary": {
        "fontSize": "14px",
        "fontWeight": "500",
        "lineHeight": "20px",
        "color": "var(--text-primary)"
      },
      "codeBlock": {
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "20px",
        "fontFamily": "var(--font-mono)"
      },
      "inlineCode": {
        "fontSize": "13.6px",
        "fontWeight": "500",
        "lineHeight": "18px",
        "fontFamily": "var(--font-mono)"
      },
      "caption": {
        "fontSize": "12px",
        "fontWeight": "400",
        "lineHeight": "16px",
        "color": "var(--text-secondary)"
      },
      "timestamp": {
        "fontSize": "11px",
        "fontWeight": "400",
        "lineHeight": "14px",
        "color": "var(--text-tertiary)"
      },
      "shortcutBadge": {
        "fontSize": "11px",
        "fontWeight": "510",
        "lineHeight": "14px",
        "color": "var(--text-secondary)"
      },
      "h1": {
        "fontSize": "28px",
        "fontWeight": "600",
        "lineHeight": "34px",
        "letterSpacing": "-0.02em"
      },
      "h2": {
        "fontSize": "22px",
        "fontWeight": "600",
        "lineHeight": "28px",
        "letterSpacing": "-0.015em"
      },
      "h3": {
        "fontSize": "18px",
        "fontWeight": "600",
        "lineHeight": "24px",
        "letterSpacing": "-0.01em"
      }
    }
  },
  "colors": {
    "themeMode": "dual (light & dark, system synchronized)",
    "light": {
      "canvas": "#ffffff",
      "surfacePrimary": "#ffffff",
      "surfaceSecondary": "#f9f9f9",
      "surfaceTertiary": "#f3f3f3",
      "hoverSurface": "rgba(0, 0, 0, 0.05)",
      "selectedSurface": "rgba(0, 0, 0, 0.08)",
      "userMessageBubble": "color-mix(in oklab, #0d0d0d 5%, transparent)",
      "userMessageBubbleFallback": "#f4f4f4",
      "textPrimary": "#0d0d0d",
      "textSecondary": "#5d5d5d",
      "textTertiary": "#8f8f8f",
      "borderSubtle": "rgba(0, 0, 0, 0.10)",
      "borderStrong": "rgba(0, 0, 0, 0.16)",
      "accentBlue": "#3a83f7",
      "accentGreen": "#04bb9f",
      "accentPurple": "#a25bff",
      "accentOrange": "#ff8066",
      "accentRed": "#fa423e",
      "accentYellow": "#ffcc38",
      "danger": "#fa423e",
      "dangerHover": "#e03733",
      "warning": "#ffcc38",
      "success": "#04bb9f"
    },
    "dark": {
      "canvas": "#212121",
      "surfacePrimary": "#212121",
      "surfaceSecondary": "#171717",
      "surfaceTertiary": "#2f2f2f",
      "hoverSurface": "rgba(255, 255, 255, 0.06)",
      "selectedSurface": "rgba(255, 255, 255, 0.10)",
      "userMessageBubble": "#2f2f2f",
      "textPrimary": "#ffffff",
      "textSecondary": "#cdcdcd",
      "textTertiary": "#8f8f8f",
      "borderSubtle": "rgba(255, 255, 255, 0.12)",
      "borderStrong": "rgba(255, 255, 255, 0.20)",
      "accentBlue": "#63a8f8",
      "accentGreen": "#1f9884",
      "accentPurple": "#9639ed",
      "accentOrange": "#f7513c",
      "accentRed": "#ff002a",
      "accentYellow": "#e39f20",
      "danger": "#ff002a",
      "dangerHover": "#e00025",
      "warning": "#e39f20",
      "success": "#1f9884"
    },
    "palette": {
      "gray0": "#ffffff",
      "gray25": "#fcfcfc",
      "gray50": "#f9f9f9",
      "gray75": "#f3f3f3",
      "gray100": "#ededed",
      "gray150": "#dfdfdf",
      "gray200": "#cdcdcd",
      "gray250": "#b9b9b9",
      "gray300": "#afafaf",
      "gray350": "#9f9f9f",
      "gray400": "#8f8f8f",
      "gray450": "#767676",
      "gray500": "#5d5d5d",
      "gray550": "#4f4f4f",
      "gray600": "#414141",
      "gray650": "#393939",
      "gray700": "#303030",
      "gray750": "#282828",
      "gray800": "#212121",
      "gray850": "#1c1c1c",
      "gray900": "#181818",
      "gray925": "#161616",
      "gray950": "#131313",
      "gray975": "#101010",
      "gray1000": "#0d0d0d"
    },
    "alphaRamp": {
      "alpha-01": "0.01",
      "alpha-02": "0.02",
      "alpha-03": "0.03",
      "alpha-04": "0.04",
      "alpha-05": "0.05",
      "alpha-06": "0.06",
      "alpha-08": "0.08",
      "alpha-10": "0.10",
      "alpha-12": "0.12",
      "alpha-14": "0.14",
      "alpha-16": "0.16"
    }
  },
  "spacing": {
    "baseUnit": "4px (0.25rem)",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "1.5": "6px",
      "2.5": "10px",
      "3.5": "14px"
    },
    "semantic": {
      "sidebarPaddingX": "12px",
      "sidebarPaddingY": "16px",
      "sidebarItemGap": "4px",
      "sidebarItemPaddingX": "10px",
      "sidebarItemHeight": "36px",
      "messageGap": "24px",
      "messageMarginX": "24px",
      "composerPadding": "10px 14px 10px 16px",
      "composerMarginBottom": "24px",
      "dialogPadding": "24px",
      "popoverPadding": "8px"
    }
  },
  "layout": {
    "viewport": {
      "minWidth": "360px",
      "desktopGutter": "32px",
      "mobileGutter": "16px"
    },
    "sidebar": {
      "expandedWidth": "260px",
      "minPreferredWidth": "240px",
      "maxPreferredWidth": "320px",
      "collapsedWidth": "0px (drawer on mobile, toggleable on desktop)",
      "headerHeight": "56px",
      "footerHeight": "56px"
    },
    "topbar": {
      "height": "56px",
      "paddingX": "16px",
      "controlSize": "36px",
      "modelPickerHeight": "36px"
    },
    "canvas": {
      "maxWidth": "768px (48rem)",
      "wideMaxWidth": "1024px (64rem)",
      "centered": true,
      "readingMeasure": "65-75 characters per line"
    },
    "composer": {
      "maxWidth": "768px",
      "borderRadius": "24px",
      "minHeight": "52px",
      "elevation": "0 0 0 1px #0000000a, 0 2px 8px 0 #0000000a, 0 4px 80px 8px #00000006",
      "darkElevation": "inset 0 0 1px 0 #fff3",
      "sendButtonSize": "32px",
      "attachmentButtonSize": "32px"
    }
  },
  "components": {
    "sidebar": {
      "width": "260px",
      "bgLight": "#f9f9f9",
      "bgDark": "#171717",
      "border": "0.5px solid var(--border-subtle)",
      "shadow": "0 3px 7.5px #00000008, 0 0 16px #00000005"
    },
    "conversationRow": {
      "height": "36px",
      "borderRadius": "8px",
      "padding": "0 10px",
      "hoverBgLight": "rgba(0, 0, 0, 0.05)",
      "hoverBgDark": "rgba(255, 255, 255, 0.06)",
      "activeBgLight": "rgba(0, 0, 0, 0.08)",
      "activeBgDark": "rgba(255, 255, 255, 0.10)"
    },
    "composer": {
      "bgLight": "#ffffff",
      "bgDark": "#2f2f2f",
      "borderRadius": "24px",
      "borderLight": "1px solid rgba(0, 0, 0, 0.10)",
      "borderDark": "1px solid rgba(255, 255, 255, 0.10)",
      "innerPadding": "10px 14px 10px 16px",
      "sendButtonSize": "32px",
      "sendButtonRadius": "9999px",
      "sendButtonBg": "#0d0d0d",
      "sendButtonDarkBg": "#ffffff",
      "sendButtonFg": "#ffffff",
      "sendButtonDarkFg": "#0d0d0d"
    },
    "userMessageBubble": {
      "maxWidth": "min(88%, calc(100% - 80px))",
      "borderRadius": "18px",
      "padding": "10px 16px",
      "bgLight": "#f4f4f4",
      "bgDark": "#2f2f2f",
      "textColorLight": "#0d0d0d",
      "textColorDark": "#ffffff"
    },
    "assistantMessageContent": {
      "width": "100%",
      "padding": "4px 0",
      "bg": "transparent",
      "textColorLight": "#0d0d0d",
      "textColorDark": "#ffffff"
    },
    "codeBlock": {
      "bgLight": "#f9f9f9",
      "bgDark": "#171717",
      "borderRadius": "10px",
      "border": "1px solid var(--border-subtle)",
      "headerHeight": "36px",
      "headerBgLight": "#f3f3f3",
      "headerBgDark": "#212121",
      "headerTextColor": "var(--text-secondary)",
      "copyButtonSize": "28px"
    },
    "modelPicker": {
      "height": "36px",
      "borderRadius": "10px",
      "padding": "0 12px",
      "border": "none",
      "hoverBgLight": "rgba(0, 0, 0, 0.05)",
      "hoverBgDark": "rgba(255, 255, 255, 0.06)"
    }
  },
  "interactions": {
    "hover": {
      "sidebarRow": "Background switches to alpha 5%, 3-dot action menu appears with 120ms fade-in",
      "button": "Subtle background darken (light) or lighten (dark) with 120ms transition",
      "iconButton": "Square 32x32 hit target, background transitions to alpha 6%, border-radius: 8px"
    },
    "focus": {
      "keyboardFocusRing": "2px solid #3a83f7 with 2px offset",
      "composerFocus": "Border becomes slightly more pronounced, no harsh browser outline, box-shadow maintains elevation"
    },
    "active": {
      "buttonScale": "transform: scale(0.98) on active press with 80ms transition"
    },
    "selected": {
      "sidebarRow": "Background switches to alpha 8% (light) / alpha 10% (dark), font-weight shifts to 510"
    },
    "disabled": {
      "button": "Opacity 0.4, cursor: not-allowed, pointer-events: none"
    }
  },
  "motion": {
    "durations": {
      "instant": "80ms",
      "fast": "120ms",
      "normal": "180ms",
      "relaxed": "240ms",
      "deliberate": "320ms"
    },
    "easings": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "linear(0, .398 10%, .682 20%, .843 30%, .925 40%, .972 50%, 1.004 60%, 1.008 70%, 1.003 80%, 1)"
    },
    "transitions": {
      "sidebarCollapse": "width 240ms cubic-bezier(0.4, 0, 0.2, 1)",
      "dialogAppear": "opacity 180ms ease-out, transform 180ms cubic-bezier(0.2, 0, 0, 1)",
      "streamingToken": "opacity 60ms linear, transform 60ms ease-out"
    }
  }
}