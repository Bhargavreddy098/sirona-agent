{
  "fontFamilies": {
    "primary": "OpenAI Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
  },
  "weights": {
    "light": 300,
    "normal": 400,
    "book": 430,
    "medium": 500,
    "mediumAlt": 510,
    "semibold": 590,
    "bold": 600,
    "heavy": 700
  },
  "scale": {
    "text-2xs": {
      "size": "11px",
      "lineHeight": "14px",
      "letterSpacing": "normal"
    },
    "text-xs": {
      "size": "12px",
      "lineHeight": "16px",
      "letterSpacing": "normal"
    },
    "text-sm": {
      "size": "14px",
      "lineHeight": "20px",
      "letterSpacing": "normal"
    },
    "text-base": {
      "size": "16px",
      "lineHeight": "24px",
      "letterSpacing": "normal"
    },
    "text-lg": {
      "size": "18px",
      "lineHeight": "28px",
      "letterSpacing": "-0.01em"
    },
    "text-xl": {
      "size": "20px",
      "lineHeight": "28px",
      "letterSpacing": "-0.015em"
    },
    "text-2xl": {
      "size": "24px",
      "lineHeight": "32px",
      "letterSpacing": "-0.02em"
    },
    "text-3xl": {
      "size": "30px",
      "lineHeight": "36px",
      "letterSpacing": "-0.025em"
    },
    "text-4xl": {
      "size": "36px",
      "lineHeight": "40px",
      "letterSpacing": "-0.03em"
    }
  },
  "roles": {
    "sidebarHeader": {
      "fontSize": "12px",
      "fontWeight": "510",
      "lineHeight": "16px",
      "color": "var(--text-tertiary)",
      "textTransform": "none"
    },
    "sidebarItem": {
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": "20px",
      "color": "var(--text-primary)"
    },
    "sidebarItemActive": {
      "fontSize": "14px",
      "fontWeight": "510",
      "lineHeight": "20px",
      "color": "var(--text-primary)"
    },
    "assistantMessage": {
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "28px",
      "color": "var(--text-primary)"
    },
    "userMessage": {
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "24px",
      "color": "var(--text-primary)"
    },
    "composerInput": {
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "24px",
      "color": "var(--text-primary)"
    },
    "composerPlaceholder": {
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "24px",
      "color": "var(--text-tertiary)"
    },
    "buttonPrimary": {
      "fontSize": "14px",
      "fontWeight": "510",
      "lineHeight": "20px",
      "color": "#ffffff"
    },
    "buttonSecondary": {
      "fontSize": "14px",
      "fontWeight": "500",
      "lineHeight": "20px",
      "color": "var(--text-primary)"
    },
    "codeBlock": {
      "fontSize": "13px",
      "fontWeight": "400",
      "lineHeight": "20px",
      "fontFamily": "var(--font-mono)"
    },
    "inlineCode": {
      "fontSize": "13.6px",
      "fontWeight": "500",
      "lineHeight": "18px",
      "fontFamily": "var(--font-mono)"
    },
    "caption": {
      "fontSize": "12px",
      "fontWeight": "400",
      "lineHeight": "16px",
      "color": "var(--text-secondary)"
    },
    "timestamp": {
      "fontSize": "11px",
      "fontWeight": "400",
      "lineHeight": "14px",
      "color": "var(--text-tertiary)"
    },
    "shortcutBadge": {
      "fontSize": "11px",
      "fontWeight": "510",
      "lineHeight": "14px",
      "color": "var(--text-secondary)"
    },
    "h1": {
      "fontSize": "28px",
      "fontWeight": "600",
      "lineHeight": "34px",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "fontSize": "22px",
      "fontWeight": "600",
      "lineHeight": "28px",
      "letterSpacing": "-0.015em"
    },
    "h3": {
      "fontSize": "18px",
      "fontWeight": "600",
      "lineHeight": "24px",
      "letterSpacing": "-0.01em"
    }
  }
}