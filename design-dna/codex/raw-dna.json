{
  "app": "Codex Desktop (Windows Developer Client)",
  "package": "OpenAI.Codex",
  "typography": {
    "fontFamilies": {
      "primary": "OpenAI Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "editor": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace",
      "terminal": "ui-monospace, Consolas, 'Courier New', monospace"
    },
    "weights": {
      "normal": 400,
      "editorMedium": 430,
      "labelMedium": 510,
      "headingBold": 590
    },
    "density": "High density (compact row heights, tabular digits)",
    "roles": {
      "toolExecutionRow": {
        "fontSize": "12px",
        "fontFamily": "var(--font-mono)",
        "lineHeight": "18px"
      },
      "terminalText": {
        "fontSize": "12px",
        "fontFamily": "var(--font-mono)",
        "lineHeight": "16px"
      },
      "diffAdded": {
        "fontSize": "12px",
        "fontFamily": "var(--font-mono)",
        "color": "#04bb9f"
      },
      "diffDeleted": {
        "fontSize": "12px",
        "fontFamily": "var(--font-mono)",
        "color": "#fa423e"
      },
      "worktreeDropdown": {
        "fontSize": "12px",
        "fontWeight": "500",
        "lineHeight": "16px"
      },
      "fileTreeItem": {
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "18px"
      },
      "approvalHeading": {
        "fontSize": "14px",
        "fontWeight": "600",
        "lineHeight": "20px"
      },
      "commandPill": {
        "fontSize": "11px",
        "fontWeight": "500",
        "fontFamily": "var(--font-mono)",
        "lineHeight": "14px"
      }
    }
  },
  "colors": {
    "canvas": {
      "light": "#ffffff",
      "dark": "#181818"
    },
    "sidebar": {
      "light": "#f3f3f3",
      "dark": "#141414"
    },
    "terminal": {
      "bg": "#0d0d0d",
      "fg": "#f9f9f9",
      "ansiRed": "#e05555",
      "ansiGreen": "#28a745",
      "ansiYellow": "#d69e2e",
      "ansiBlue": "#3182ce",
      "ansiMagenta": "#9f7aea",
      "ansiCyan": "#319795"
    },
    "diff": {
      "addedBg": "rgba(4, 187, 159, 0.12)",
      "addedBorder": "#04bb9f",
      "deletedBg": "rgba(250, 66, 62, 0.12)",
      "deletedBorder": "#fa423e",
      "lineNumberFg": "rgba(255, 255, 255, 0.35)"
    },
    "git": {
      "modified": "#e39f20",
      "staged": "#04bb9f",
      "untracked": "#3566f0",
      "conflict": "#fa423e"
    },
    "approvalCard": {
      "bgLight": "#ffffff",
      "bgDark": "#212121",
      "borderLight": "1px solid rgba(0, 0, 0, 0.14)",
      "borderDark": "1px solid rgba(255, 255, 255, 0.14)",
      "riskBadgeBg": "rgba(250, 66, 62, 0.12)",
      "riskBadgeFg": "#fa423e"
    }
  },
  "spacing": {
    "baseUnit": "4px",
    "panelPadding": "12px",
    "toolbarPadding": "16px",
    "rowHeight": "28px - 32px (dense)",
    "splitRatio": {
      "sidebar": "clamp(240px, 275px, 520px)",
      "taskPanel": "40%",
      "editorDiffPanel": "60%"
    }
  },
  "layout": {
    "shell": "Multi-pane responsive desktop IDE architecture with continuous superellipses",
    "sidebarWidth": "clamp(240px, var(--codex-sidebar-preferred-width, 275px), min(520px, calc(100vw - 320px)))",
    "panelGutters": "1px solid var(--border-subtle)",
    "cornerSuperellipse": "superellipse(1.5) with corner-radius-scale: 1.25",
    "splitPanes": [
      "Navigation / Worktrees",
      "Task Transcript / Agent Output",
      "Diff / File Editor",
      "Terminal Output"
    ]
  },
  "components": {
    "approvalDialog": {
      "width": "480px",
      "radius": "16px",
      "elevation": "0 8px 32px rgba(0, 0, 0, 0.24)",
      "padding": "20px"
    },
    "toolCard": {
      "bg": "var(--surface-secondary)",
      "border": "1px solid var(--border-subtle)",
      "radius": "8px",
      "padding": "10px 12px",
      "headerHeight": "28px",
      "outputBg": "var(--surface-tertiary)"
    },
    "worktreeDropdown": {
      "height": "28px",
      "radius": "6px",
      "padding": "0 8px"
    },
    "diffViewer": {
      "fontFamily": "var(--font-mono)",
      "fontSize": "12px",
      "lineHeight": "18px",
      "lineNumberWidth": "40px"
    }
  },
  "interactions": {
    "approvalAccept": "Instant optimistic state update, button shows checkmark spinner",
    "fileRowHover": "Right-aligned actions appear, subtle background shift",
    "diffInlineScrub": "Hovering over line reveals git blame and rollback icons",
    "toolCardToggle": "Smooth 180ms height transition revealing stdout/stderr logs"
  },
  "motion": {
    "tabSwitch": "120ms ease-out",
    "diffExpand": "180ms cubic-bezier(0.2, 0, 0, 1)",
    "agentPulse": "1.2s ease-in-out infinite"
  }
}