    },
    "dependency-groups": {
      "dev": [
        "debugpy==1.8.20",
        "pytest==9.1.1",
        "pytest-asyncio==1.3.0",
        "mcp==2.3.0",
        "httpx2==2.12.0",
        "starlette==1.3.1",
        "ty==0.0.82",
        "ruff==0.15.10",
        "setuptools==83.0.0"
      ],
      "test": [
        "distlib==0.4.3; sys_platform == 'win32'",
        "anthropic==0.87.0"
      ]
    },
    "build-system": {
      "requires": [
        "setuptools==83.0.0",
        "wheel"
      ],
      "build-backend": "setuptools.build_meta"
    },
    "tool": {
      "hermes": {
        "opt-in-extras": [
          "kittentts"
        ],
        "extras-platforms": {
          "matrix": "sys_platform == 'linux'",
          "google-chat": "platform_machine != 'ARM64' or sys_platform != 'win32'",
          "wake-openwakeword": "(platform_machine != 'ARM64' or sys_platform != 'win32') and (platform_machine != 'x86_64' or sys_platform != 'darwin')",
          "stt-whisper": "(platform_machine != 'ARM64' or sys_platform != 'win32') and (platform_machine != 'x86_64' or platform_system != 'Darwin') and sys_platform != 'android'",
          "neutts": "python_version < '3.14'",
          "kittentts": "(platform_machine != 'ARM64' or sys_platform != 'win32') and (platform_machine != 'x86_64' or sys_platform != 'darwin') and sys_platform != 'android'",
          "piper": "(platform_machine != 'ARM64' or sys_platform != 'win32') and (platform_machine != 'x86_64' or sys_platform != 'darwin') and sys_platform != 'android'",
          "google-meet": "sys_platform != 'android'"
        }
      },
      "uv": {
        "default-groups": [],
        "environments": [
          "python_version >= '3.14'"
        ],
        "override-dependencies": [
          "pynacl>=1.6,<1.7",
          "cryptography==50.0.1",
          "Pillow==13.0.0",
          "spacy-curated-transformers; sys_platform == 'never'"
        ],
        "exclude-newer": "3 days",
        "exclude-newer-package": {
          "certifi": false
        }
      },
      "setuptools": {
        "packages": {
          "find": {
            "include": [
              "agent",
              "agent.*",
              "tools",
              "tools.*",
              "hermes_cli",
              "hermes_cli.*",
              "gateway",
              "gateway.*",
              "tui_gateway",
              "tui_gateway.*",
              "cron",
              "cron.*",
              "acp_adapter",
              "plugins",
              "plugins.*",
              "providers",
              "providers.*",
              "hermes_platform",
              "hermes_platform.*",
              "pm",
              "pm.*",
              "tools",
              "tools.*"
            ]
          }
        },
        "package-data": {
          "hermes_cli": [
            "observability/schemas/*.json",
            "data/*.json",
            "local_runtime/*.json"
          ],
          "gateway": [
            "assets/**/*"
          ],
          "plugins": [
            "**/plugin.yaml",
            "**/plugin.yml"
          ],
          "pm": [
            "lock.json",
            "artifact-mirror.json",
            "pyproject.toml",
            "uv.lock"
          ],
          "tools": [
            "bot_desktop/launcher.sh",
            "bot_desktop/wallpaper.png"
          ]
        }
      },
      "pytest": {
        "ini_options": {
          "testpaths": [
            "tests"
          ],
          "markers": [
            "integration: marks tests requiring external services (API keys, Modal, etc.)",
            "live: secrets-gated canaries against REAL LLM provider APIs (spends money; select with -m live)",
            "real_concurrent_gate: opt out of the autouse stub that disables _detect_concurrent_hermes_instances",
            "real_agent_prewarm: opt out of the autouse stub that disables the tui_gateway deferred agent pre-warm timer",
            "real_retry_backoff: opt out of the tests/agent autouse stub that zeroes jittered_backoff",
            "requires_wal: needs the runtime to actually enable SQLite WAL mode (skipped where Hermes falls back to journal_mode=DELETE)",
            "no_isolate: opt out of per-file subprocess isolation (tests share mutable module-level state)",
            "ssh: marks tests requiring a reachable SSH server (skipped in normal CI)",
            "platforms(*specs, arch=None, arch_negate=False): run only on hosts matching at least one spec â€” linux/macos/windows/posix/any, 'not X' negation, optional arch filter"
          ],
          "addopts": "-m 'not integration and not live'"
        }
      },
      "ty": {
        "environment": {
          "python-version": "3.13"
        },
        "rules": {
          "unknown-argument": "warn",
          "redundant-cast": "ignore"
        }
      },
      "ruff": {
        "preview": true,
        "lint": {
          "select": [
            "PLW1514",
            "ASYNC210",
            "ASYNC220",
            "ASYNC221",
            "ASYNC251",
            "TID251"
          ],
          "flake8-tidy-imports": {
            "banned-api": {
              "pm.uv": {
                "msg": "Use PM's semantic Python operations, not an installer executable."
              },
              "pm.client.uv": {
                "msg": "Use PM's semantic Python operations."
              },
              "pm.install.uv": {
                "msg": "The raw uv bridge was removed; use PM operations."
              },
              "pm._uv": {
                "msg": "Tool acquisition is private to PM."
              },
              "pm.environment": {
                "msg": "The environment engine is private; use PM operations."
              },
              "pm.runtime_stage": {
                "msg": "PM stages its own worker runtime; consumers call pm operations."
              }
            }
          },
          "per-file-ignores": {
            "pm/**": [
              "TID251"
            ],
            "apps/desktop/electron/fixtures/**": [
              "TID251"
            ],
            "tests/**": [
              "PLW1514",
              "ASYNC210",
              "ASYNC220",
              "ASYNC221",
              "ASYNC251",
              "TID251"
            ],
            "skills/**": [
              "PLW1514"
            ],
            "optional-skills/**": [
              "PLW1514"
            ],
            "plugins/**": [
              "PLW1514"
            ],
            "gateway/run.py": [
              "ASYNC220"
            ],
            "gateway/run_shutdown.py": [
              "ASYNC220"
            ],
            "gateway/slash_commands.py": [
              "ASYNC220"
            ],
            "hermes_cli/web_routers/profiles.py": [
              "ASYNC220",
              "ASYNC221"
            ],
            "plugins/platforms/whatsapp/adapter.py": [
              "ASYNC220",
              "ASYNC221"
            ],
            "plugins/platforms/photon/adapter.py": [
              "ASYNC220"
            ]
          }
        }
      }
    }
  }
